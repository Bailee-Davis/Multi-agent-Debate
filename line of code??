    "def get_llm_response(system_prompt, user_prompt):\n",
    "    \"\"\"Get respoonse from Groq API\"\"\"\n",
    "    response = client.chat.completions.create(\n",
    "        model=GROQ_MODEL, #changed to Groq model\n",
    "        messages=[\n",
    "            {\"role\": \"system\", \"content\": system_prompt},\n",
    "            {\"role\": \"user\", \"content\": user_prompt}\n",
    "        ],\n",
    "        temperature=0.7,  # Added missing comma here\n",
    "        max_tokens=2000\n",
    "    )\n",
    "    return response.choices[0].message.content\n",
    "\n",
    "# Define System Prompts for each role\n",
    "PROPOSITION_PROMPT = (\n",
    "    \"You are an academic debater representing the PROPOSITION. \"\n",
    "    \"You argue IN FAVOR of the motion: 'Researchers should use LLMs as control groups for data and compare it to humans.' \"\n",
    "    \"Your arguments should emphasize scalability, cost-efficiency, standardized baseline testing, \"\n",
    "    \"reproducibility, and the ability of LLMs to simulate aggregate human behavioral patterns.\"\n",
    ")\n",
    "\n",
    "OPPOSITION_PROMPT = (\n",
    "    \"You are an academic debater representing the OPPOSITION. \"\n",
    "    \"You argue AGAINST the motion: 'Researchers should use LLMs as control groups for data and compare it to humans.' \"\n",
    "    \"Your arguments should emphasize the lack of authentic human experience, missing neurobiological/emotional grounding, \"\n",
    "    \"sampling biases in training data, inability to reflect true human variance, and ethical/methodological risks.\"\n",
    ")\n",
    "\n",
    "JUDGE_PROMPT = (\n",
    "    \"You are an expert academic debate judge evaluating a formal debate. \"\n",
    "    \"Your job is to objectively analyze the constructive arguments, rebuttals, and closing speeches from both sides. \"\n",
    "    \"Declare a clear WINNER (Proposition or Opposition), explain the primary voting issues that decided the round, \"\n",
    "    \"and provide constructive feedback on the logical strength of each side's case.\"\n",
    ")  # Added missing closing parenthesis here\n",
    "\n",
    "def run_formal_debate(topic):\n",
    "    transcript = f\"MOTION: {topic}\\n\\n\"\n",
    "    transcript += \"=\" * 60 + \"\\n\\n\"\n",
    "\n",
    "    # 1. Proposition Opening Speech\n",
    "    print(\">>> Stage 1: Proposition Constructive Speech...\")\n",
    "    prop_opening_prompt = (\n",
    "        f\"The motion is: '{topic}'.\\n\\n\"\n",
    "        f\"Deliver your 3-paragraph Opening Speech laying out your primary case for why \"\n",
    "        f\"LLMs should be used as control groups.\"\n",
    "    )\n",
    "    prop_opening = get_llm_response(PROPOSITION_PROMPT, prop_opening_prompt)\n",
    "    print(f\"\\n[ PROPOSITION OPENING ]\\n{prop_opening}\\n\")\n",
    "    transcript += f\"--- PROPOSITION OPENING ---\\n{prop_opening}\\n\\n\"\n",
    "\n",
    "    # 2. Opposition Opening Speech\n",
    "    print(\">>> Stage 2: Opposition Opening Speech...\")\n",
    "    opp_opening_prompt = (\n",
    "        f\"The motion is: '{topic}'.\\n\\n\"\n",
    "        f\"Here is the Proposition's opening speech:\\n{prop_opening}\\n\\n\"\n",
    "        f\"Deliver your 3-paragraph Opening Speech laying out your case against using LLMs as control groups, \"\n",
    "        f\"while briefly clashing with the Proposition's opening points.\"\n",
    "    )\n",
    "    opp_opening = get_llm_response(OPPOSITION_PROMPT, opp_opening_prompt)\n",
    "    print(f\"\\n[ OPPOSITION OPENING]\\n{opp_opening}\\n\")\n",
    "    transcript += f\"--- OPPOSITION OPENING ---\\n{opp_opening}\\n\\n\"\n",
    "\n",
    "    # 3. Proposition Rebuttal & Closing Speech\n",
    "    print(\">>> Stage 3: Proposition Rebuttal & Closing Speech...\")\n",
    "    prop_closing_prompt = (\n",
    "        f\"The motion is: '{topic}'.\\n\\n\"\n",
    "        f\"The Opposition argued:\\n{opp_opening}\\n\\n\"\n",
    "        f\"Deliver your Rebuttal and Closing Speech. Address the Opposition's main criticism.\"\n",
    "    )\n",
    "    prop_closing = get_llm_response(PROPOSITION_PROMPT, prop_closing_prompt)\n",
    "    print(f\"\\n[ PROPOSITION REBUTTAL & CLOSING ]\\n{prop_closing}\\n\")\n",
    "    transcript += (\n",
    "        f\"--- PROPOSITION REBUTTAL & CLOSING ---\\n{prop_closing}\\n\\n\"\n",
    "    )\n",
    "\n",
    "    # 4. Opposition Rebuttal & Closing Speech\n",
    "    print(\">>> Stage 4: Opposition Rebuttal & Closing Speech...\")\n",
    "    opp_closing_prompt = (\n",
    "        f\"The motion is: '{topic}'.\\n\\n\"\n",
    "        f\"Here is the Proposition's final rebuttal and closing speech:\\n{prop_closing}\\n\\n\"\n",
    "        f\"Deliver your Rebuttal and Closing Speech. Refute the Proposition's final points, \"\n",
    "        f\"summarize the core flaws in their framework, and make your final pitch to the judge.\"\n",
    "    )\n",
    "    opp_closing = get_llm_response(OPPOSITION_PROMPT, opp_closing_prompt)\n",
    "    print(f\"\\n[ OPPOSITION REBUTTAL & CLOSING ]\\n{opp_closing}\\n\")\n",
    "    transcript += f\"--- OPPOSITION REBUTTAL & CLOSING ---\\n{opp_closing}\\n\\n\"\n",
    "\n",
    "    # 5. Judge Verdict\n",
    "    print(\"=\" * 60)\n",
    "    print(\">>> Stage 5: Judge Evaluation & Verdict...\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    judge_prompt = (\n",
    "        f\"Read the following debate transcript carefully:\\n\\n{transcript}\\n\\n\"\n",
    "        f\"As the Judge, provide your decision with the following structure:\\n\"\n",
    "        f\"1. WINNER: State clearly whether Proposition or Opposition won.\\n\"\n",
    "        f\"2. REASON FOR DECISION: Explain the main voting issues and key arguments that decided your vote.\\n\"\n",
    "        f\"3. FEEDBACK FOR PROPOSITION: Strengths and weaknesses of their performance.\\n\"\n",
    "        f\"4. FEEDBACK FOR OPPOSITION: Strengths and weaknesses of their performance.\"\n",
    "    )\n",
    "    judge_verdict = get_llm_response(JUDGE_PROMPT, judge_prompt)\n",
    "    print(f\"\\n[ JUDGE VERDICT ]\\n{judge_verdict}\\n\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    motion = \"Researchers should use LLMs as control groups for data and compare it to humans.\"\n",
    "    run_formal_debate(motion)"
   ]
